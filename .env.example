# APEX GYM MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gym_management_db

# Security / JWT
JWT_SECRET_KEY=apex_gym_jwt_secret_token_key_2026_super_secure
JWT_EXPIRES_HOURS=24

# Application Server
FLASK_ENV=development
FLASK_PORT=5000
DEBUG=True

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216 # 16 MB

# CORS
CORS_ORIGIN=*
